<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>piper_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 bridge for the AgileX Piper arm: /joint_states from CAN feedback and FollowJointTrajectory action servers for MoveIt, on top of piper_sdk.</description>
  <maintainer email="hi25078@bristol.ac.uk">Yufei Zhao</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>piper_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
